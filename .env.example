# ==============================================================================
# ENVIRONMENT CONFIGURATION (PLACEHOLDER VALUES ONLY)
# Never commit real credentials, tokens, or private IDs to git or public repos.
# ==============================================================================

# APP_URL: The URL where this applet is hosted (optional in dev, Cloud Run / Vercel in prod).
APP_URL="https://example.com"

# ------------------------------------------------------------------------------
# TELEGRAM BOT INTEGRATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Secret Bot Token obtained from @BotFather. Never expose to client or prefix with VITE_.
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Target Telegram Chat ID (group ID like -100xxxxxxxxxx or private chat ID).
TELEGRAM_CHAT_ID="-1001234567890"

# ------------------------------------------------------------------------------
# DISTRIBUTED RATE LIMITING (OPTIONAL FOR MULTI-INSTANCE SERVERLESS DEPLOYMENTS)
# ------------------------------------------------------------------------------
# If deploying to Vercel and using Upstash Redis / Vercel KV for shared rate limiting:
# Obtain these from your Upstash console (https://console.upstash.com) or Vercel KV.
# If not provided, an automatic in-memory sliding window rate limiter is used.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# OPTIONAL ADMIN ACCESS KEYS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Optional secret bearer token to inspect order count via GET /api/orders
ADMIN_API_KEY=""

# Optional secret to authorize asset uploads via POST /api/upload-asset
ADMIN_ASSET_SECRET=""
